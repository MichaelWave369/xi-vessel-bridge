{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xi-vessel-bridge.dev/spec/capability.schema.json",
  "title": "Xi Capability Advertisement",
  "type": "object",
  "additionalProperties": false,
  "required": ["capability_id", "kind", "version", "permission_mode"],
  "properties": {
    "capability_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "kind": {"enum": ["tool", "model", "storage", "capsule_format", "other"]},
    "version": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "permission_mode": {"enum": ["read_only", "explicit_grant", "disabled"]},
    "operations": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "constraints": {"type": "object"}
  }
}
